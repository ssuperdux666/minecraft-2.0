{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build and run",
            "type": "shell",
            "command": "g++ src/*.cpp src/glad.c -Iinclude -Llib -lglfw3dll -lopengl32 -lgdi32 -o cutable.exe; if ($?) { Start-Process .\\cutable.exe }",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },
    ]
}